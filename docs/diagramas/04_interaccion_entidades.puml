@startuml
title PoC A02 - Diagrama de interacción de entidades
skinparam shadowing false
left to right direction
skinparam componentStyle rectangle
actor "Cliente" as Cliente
actor "Asesor" as Asesor
rectangle "Plataforma de análisis de solicitudes" {
  component "Recepción de\nsolicitudes" as REC
  component "Orquestador A02" as ORQ
  component "Agente clasificador" as CLA
  component "Agente extractor" as EXT
  component "Verificador de\ncompletitud (D1)" as VER
  component "Redactor de\npreguntas (A03)" as RED
  component "Registro de trazas\n(prompts, tiempo, costo)" as LOG
}
entity "Cliente\n(datos de contacto)" as E1
entity "Solicitud\n(texto, canal, estado)" as E2
entity "AnalisisSolicitud\n(JSON A02)" as E3
cloud "LLM\n(Claude / GPT)" as LLM
Cliente --> REC : 1. mensaje
Asesor --> REC : 2. registra
REC --> E1 : 3. crea/actualiza
REC --> E2 : 4. crea
REC --> ORQ : 5. solicita análisis
ORQ --> CLA : 6a
ORQ --> EXT : 6b
CLA --> LLM
EXT --> LLM
ORQ --> VER : 7. requerimientos
VER --> RED : 8. faltantes
RED --> LLM
ORQ --> E3 : 9. persiste
ORQ --> LOG : 10. traza
E3 --> Asesor : 11. revisión humana
@enduml
