@startuml
title MVP - Casos de uso del asistente de análisis de solicitudes (A02)
skinparam shadowing false
left to right direction
actor "Usuario visitante\n(cliente potencial)" as V
actor "Usuario logueado\n(Asesor de atención)" as A
actor "Usuario logueado\n(Administrador / Líder)" as ADM
A <|-- ADM
actor "Proveedor LLM" as LLM <<sistema>>
rectangle "Sistema de análisis de solicitudes - OrigenTours" {
  usecase "CU-01 Enviar solicitud\npor formulario web" as UC1
  usecase "CU-02 Iniciar sesión" as UC2
  usecase "CU-03 Registrar solicitud\nrecibida por correo/WhatsApp" as UC3
  usecase "CU-04 Analizar solicitud\ncon GenAI (JSON A02)" as UC4
  usecase "CU-05 Validar esquema\ny detectar faltantes (D1)" as UC5
  usecase "CU-06 Generar preguntas\nde aclaración" as UC6
  usecase "CU-07 Revisar y corregir\nel análisis" as UC7
  usecase "CU-08 Aprobar traspaso\na diseño" as UC8
  usecase "CU-09 Consultar historial\nde solicitudes" as UC9
  usecase "CU-10 Comparar modelos\ny ver métricas de la PoC" as UC10
}
V --> UC1
A --> UC2
A --> UC3
A --> UC7
A --> UC8
A --> UC9
ADM --> UC10
UC1 ..> UC4 : <<include>>
UC3 ..> UC4 : <<include>>
UC4 ..> UC5 : <<include>>
UC6 .> UC5 : <<extend>>\n[faltan campos]
UC4 --> LLM
UC6 --> LLM
UC7 ..> UC2 : <<include>>
UC8 ..> UC2 : <<include>>
@enduml
