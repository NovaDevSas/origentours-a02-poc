# Puerto de la API
PORT=4000
# Origen permitido para el frontend (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Proveedor LLM por defecto: mock | anthropic | openai
LLM_PROVIDER=mock

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ChatGPT (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Umbral de confianza para revisión humana
UMBRAL_CONFIANZA=0.8
